{
  "name": "multi-shop-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:billing": "cypress run --spec 'cypress/e2e/01-billing-cash.cy.js'",
    "cy:run:split": "cypress run --spec 'cypress/e2e/02-split-payment.cy.js'",
    "cy:run:credit": "cypress run --spec 'cypress/e2e/03-credit-flow.cy.js'",
    "cy:run:refund": "cypress run --spec 'cypress/e2e/04-partial-refund.cy.js'",
    "cy:run:variant": "cypress run --spec 'cypress/e2e/05-variant-stock.cy.js'",
    "cy:run:payment": "cypress run --spec 'cypress/e2e/06-payment-mismatch.cy.js'",
    "cy:run:stock": "cypress run --spec 'cypress/e2e/07-negative-stock.cy.js'",
    "cy:run:climit": "cypress run --spec 'cypress/e2e/08-credit-limit.cy.js'",
    "cy:run:expiry": "cypress run --spec 'cypress/e2e/09-expired-product.cy.js'",
    "cy:run:network": "cypress run --spec 'cypress/e2e/10-network-failure.cy.js'",
    "cy:run:core": "cypress run --spec 'cypress/e2e/0{1,2,3,4,5}-*.cy.js'",
    "cy:run:advanced": "cypress run --spec 'cypress/e2e/{06,07,08,09,10}-*.cy.js'"
  },
  "dependencies": {
    "@capacitor/push-notifications": "^8.0.2",
    "@tanstack/react-query": "^5.28.0",
    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "cypress": "^13.17.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^7.2.0"
  }
}

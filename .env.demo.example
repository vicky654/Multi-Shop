# ─────────────────────────────────────────────────────────────────────────────
#  Demo Asset Automation — configuration
#  Copy to `.env.demo` (gitignored) and fill in. Never commit `.env.demo`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Demo account credentials ─────────────────────────────────────────────────
# The isolated demo owner the automation logs in as. These are throwaway
# credentials for a disposable database — but they are still read from this file
# and never hardcoded, logged, or typed on screen during capture.
DEMO_EMAIL=demo.owner@multishop-demo.test
DEMO_PASSWORD=change-me-demo-pass

# ── Isolated demo database ───────────────────────────────────────────────────
# MUST be a separate database whose name contains "demo" — the server refuses to
# start in demo mode otherwise. The seeder WIPES this database on every run.
# Use the same cluster as dev if you like; only the database name must differ.
DEMO_DATABASE_URI=mongodb://localhost:27017/multi-shop-demo

# ── Fake company shown in all captured assets ────────────────────────────────
DEMO_COMPANY_NAME=Nova Retail Group
DEMO_COMPANY_TAGLINE=Multi-store retail, one dashboard

# ── Marketing website ────────────────────────────────────────────────────────
# Absolute path to YOUR local marketing site repo (multishop-erp-website).
# Never a deployed URL — assets are copied on disk. Written to:
#   $MARKETING_WEBSITE_PATH/public/images/product/*.webp   (re-encoded from PNG;
#     the site hardcodes .webp in lib/product-screens.ts and components/home/hero.tsx)
#   $MARKETING_WEBSITE_PATH/public/videos/multishop-demo.mp4
# Leave blank to stop after capture (assets stay in scripts/demo/output).
# e.g. MARKETING_WEBSITE_PATH=C:/Users/you/multishop-erp-website
MARKETING_WEBSITE_PATH=

# ── Local app under test ─────────────────────────────────────────────────────
DEMO_API_PORT=5055
DEMO_WEB_PORT=4055

# ── Capture tuning ───────────────────────────────────────────────────────────
# Viewport for screenshots and video. 1920x1200 matches the dimensions the
# marketing site's existing product assets use (see lib/product-screens.ts).
DEMO_VIEWPORT_WIDTH=1920
DEMO_VIEWPORT_HEIGHT=1200

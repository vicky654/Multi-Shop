PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/multi-shop
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:4000

# ── Firebase Cloud Messaging (Push Notifications) ──────────────────────────────
# Get these from Firebase Console → Project Settings → Service Accounts
# → Generate new private key → copy values from the downloaded JSON
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the full private key — keep the \n literals, they are converted at runtime
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG...\n-----END PRIVATE KEY-----\n"

# ── Testing ───────────────────────────────────────────────────────────────────
# Dedicated database for E2E runs. REQUIRED when NODE_ENV=test or USE_TEST_DB=1.
# The database name must contain "test" — the server refuses to start otherwise,
# so a test run can never touch production data.
TEST_DATABASE_URI=mongodb://localhost:27017/multi-shop-test

# Disposable database for demo-asset capture (npm run demo:update).
# Name must contain "demo". Set in .env.demo — listed here for completeness.
# DEMO_DATABASE_URI=mongodb://localhost:27017/multi-shop-demo

# ── Rate limiting ─────────────────────────────────────────────────────────────
# PRODUCTION IGNORES EVERY VARIABLE IN THIS SECTION. When NODE_ENV=production the
# server always uses the strict built-in limits (10 auth attempts / 15 min,
# 200 API requests / min), so copying a relaxed .env onto a production host cannot
# weaken brute-force protection.
#
# The overrides apply only when NODE_ENV is development, test or demo. Use them
# when an E2E suite or a demo script logs in more often than a real user would and
# trips the strict auth limit. Rate limiting itself is never disabled: 0, negative
# and non-numeric values fall back to (or are clamped towards) the strict limits.
#
# The limiter is in-memory, so restarting the server clears any accumulated 429.
#
# Login/auth endpoints — max attempts per window per IP (clamped to 1..10000).
# AUTH_RATE_LIMIT_MAX=100
# Auth window in milliseconds (clamped to 1s..1h). Default 900000 = 15 minutes.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# General API limiter. NOTE: apiLimiter is currently not mounted on any route, so
# these two have no effect until it is. Kept documented so the pair stays together.
# API_RATE_LIMIT_MAX=200
# API window in milliseconds (clamped to 1s..1h). Default 60000 = 1 minute.
# API_RATE_LIMIT_WINDOW_MS=60000
